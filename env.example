# Copy to mcp/.env.local (git-ignored) and fill in. Never commit real values.
# The news and public-record import (scripts/ingest-record.ts) reads these.

# SEC EDGAR refuses requests without a contact in the user agent.
# Format the SEC asks for: Company Name contact-email
SEC_USER_AGENT=

# Free API token from https://www.courtlistener.com/ (Profile, then API).
COURTLISTENER_TOKEN=

# The thin client (src/remote-server.ts, src/server.ts in the public copy) reads
# these from its environment. Keys come from the TrustFit account page.
TRUSTFIT_API_KEY=
# Optional. Default https://trustfit-iota.vercel.app
TRUSTFIT_API_BASE=

# Optional free keys for the open-data ingests (scripts/ingest-open.ts).
# Without them the scripts still work, only slower.
# GitHub token with no scopes (Settings, Developer settings, fine-grained, public read):
# raises the advisory API limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=
# NVD API key, free from https://nvd.nist.gov/developers/request-an-api-key
# (5 requests per 30 seconds without it, 50 with it).
NVD_API_KEY=
